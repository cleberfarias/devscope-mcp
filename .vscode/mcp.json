{
  "servers": {
    "devscope-local": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "devscope.server",
        "--project-root",
        "${workspaceFolder}",
        "--config",
        "${workspaceFolder}/devscope.json"
      ]
    }
  }
}
